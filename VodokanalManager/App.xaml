<Application x:Class="VodokanalManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VodokanalManager"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VodokanalManager;component/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/VodokanalManager;component/Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/VodokanalManager;component/Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

<common:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <common:StringToVisibilityConverter x:Key="StringToVis" />
            <common:BoolToVisibilityConverter x:Key="BoolToVis" />
            <common:DecimalToRubConverter x:Key="DecimalToRub" />
            <common:DecimalToRubConverter x:Key="DecimalToRubConverter" />
            <common:DebtToColorConverter x:Key="DebtToColor" />
            <common:DebtToColorConverter x:Key="DebtToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
