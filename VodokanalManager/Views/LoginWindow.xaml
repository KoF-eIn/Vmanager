<Window x:Class="VodokanalManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — ООО «Водоканал-Сервис»"
        Height="470" Width="430"
        MinHeight="430" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Border Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="16" CornerRadius="8" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center">

<StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Path Data="{StaticResource IconWaterDrop}"
                          Fill="{StaticResource BrandPrimaryBrush}"
                          Width="44" Height="44"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>

                    <TextBlock Text="ООО «Водоканал-Сервис»"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeaderBackgroundBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="г. Канск • Абонентский учёт и платежи"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

<Border Background="{StaticResource DangerLightBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

<TextBlock Text="Имя пользователя (логин):" Style="{StaticResource LabelTextStyle}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

<TextBlock Text="Пароль:" Style="{StaticResource LabelTextStyle}"/>
                <PasswordBox x:Name="UserPasswordBox"
                             PasswordChanged="UserPasswordBox_PasswordChanged"
                             Margin="0,0,0,20"/>

<Button Content="Войти в систему"
                        Command="{Binding LoginCommand}"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="0,0,0,16"/>

                <Border Background="{StaticResource CardAltBackgroundBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,12">
                    <TextBlock Text="💡 Для входа используйте учётную запись сотрудника или номер лицевого счёта абонента."
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Красноярский край, г. Канск • Версия 1.0"
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
