<Window x:Class="VodokanalManager.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предварительный просмотр квитанции водоканала"
        Height="720" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPrint}" Fill="{StaticResource BrandPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Квитанция на оплату услуг водоснабжения и водоотведения" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Распечатать квитанцию" Click="PrintButton_Click" Margin="0,0,8,0" Width="170"/>
                    <Button Content="Закрыть" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" Width="90"/>
                </StackPanel>
            </Grid>
        </Border>

<FlowDocumentScrollViewer Grid.Row="1" x:Name="ReceiptViewer" Background="#F1F5F9" Margin="0"/>
    </Grid>
</Window>
