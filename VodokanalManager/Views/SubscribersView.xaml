<UserControl x:Class="VodokanalManager.Views.SubscribersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:StringToVisibilityConverter x:Key="StringToVis" />
        <common:DecimalToRubConverter x:Key="DecimalToRub" />
        <common:DebtToColorConverter x:Key="DebtToColor" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

<Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

<WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 ToolTip="Поиск по номеру лицевого счёта, ФИО абонента или адресу"/>
                    </StackPanel>

<StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Тип абонента:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ComboBox SelectedIndex="{Binding SelectedSubscriberTypeId}" Width="160">
                            <ComboBoxItem Content="Все категории" />
                            <ComboBoxItem Content="Физические лица" />
                            <ComboBoxItem Content="Организации" />
                        </ComboBox>
                    </StackPanel>

<CheckBox Content="Только с задолженностью"
                              IsChecked="{Binding OnlyWithDebt}"
                              VerticalAlignment="Center"
                              FontWeight="Medium"
                              Margin="0,0,16,0"/>
                </WrapPanel>

<WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button Content="Добавить абонента"
                            Command="{Binding AddSubscriberCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Редактировать"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditSubscriberCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Изменить статус"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleActiveCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Удалить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteSubscriberCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Удалить выбранного абонента"/>

                    <Button Content="Обновить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

<StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

<DataGrid Grid.Row="2"
                  ItemsSource="{Binding Subscribers}"
                  SelectedItem="{Binding SelectedSubscriber}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Лицевой счёт" Binding="{Binding AccountNo}" Width="110"/>
                <DataGridTextColumn Header="Абонент (ФИО / Наименование)" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding SubscriberTypeName}" Width="130"/>
                <DataGridTextColumn Header="Адрес объекта" Binding="{Binding Address}" Width="260"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Начислено, ₽" Binding="{Binding TotalChargedRub, StringFormat=N2}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Оплачено, ₽" Binding="{Binding TotalPaidRub, StringFormat=N2}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Задолженность, ₽" Binding="{Binding DebtRub, StringFormat=N2}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{Binding DebtRub, Converter={StaticResource DebtToColor}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

<Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Карточка абонента:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SelectedSubscriber.Name, TargetNullValue='Выберите абонента из таблицы'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource HeaderBackgroundBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedSubscriber.Address}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding SelectedSubscriber.AccountNo, StringFormat='Лицевой счёт: {0}'}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedSubscriber.DebtRub, StringFormat='Текущий долг: {0:N2} ₽'}" FontSize="12" FontWeight="Bold" Foreground="{Binding SelectedSubscriber.DebtRub, Converter={StaticResource DebtToColor}}" Margin="0,3,0,0"/>
                </StackPanel>

<StackPanel Grid.Column="1">
                    <TextBlock Text="Установленные приборы учёта (счётчики воды):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding SelectedSubscriberMeters}" Height="110" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTypeName}" Width="150"/>
                            <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNo}" Width="140"/>
                            <DataGridTextColumn Header="Дата установки" Binding="{Binding InstallDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Последнее показание, м³" Binding="{Binding LastReadingM3, StringFormat=N3}" Width="170"/>
                            <DataGridTextColumn Header="Статус прибора" Binding="{Binding StatusText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
