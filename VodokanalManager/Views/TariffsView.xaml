<UserControl x:Class="VodokanalManager.Views.TariffsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Карточка ввода нового тарифа -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Утверждение нового тарифа на водоснабжение:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="Услуга:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox SelectedIndex="{Binding NewServiceTypeId, ConverterParameter=1}" Width="220">
                            <ComboBoxItem Content="Холодное водоснабжение (ХВС)" IsSelected="True"/>
                            <ComboBoxItem Content="Горячее водоснабжение (ГВС)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="Дата начала действия:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding NewValidFrom}" Width="130"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="Тариф, ₽/м³:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding NewPriceRub, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <Button Content="Утвердить и ввести тариф"
                            Command="{Binding AddTariffCommand}"
                            Margin="0,0,8,8"/>

                    <Button Content="Обновить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Баннеры сообщений -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Таблица тарифов -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Реестр действующих и архивных тарифов:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Tariffs}"
                          SelectedItem="{Binding SelectedTariff}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Коммунальная услуга" Binding="{Binding ServiceTypeName}" Width="260"/>
                        <DataGridTextColumn Header="Дата вступления в силу" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="200"/>
                        <DataGridTextColumn Header="Тариф за 1 м³, ₽" Binding="{Binding PriceRubPerM3, StringFormat=N2}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Стоимость за 1 м³ (в копейках)" Binding="{Binding PriceKopPerM3}" Width="240"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                    <TextBlock Text="ℹ️ Исторические тарифы не подлежат редактированию и удалению для гарантии целостности финансовых расчётов за прошлые расчетные месяцы. При повышении цен утверждается новая запись с первого числа месяца."
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
