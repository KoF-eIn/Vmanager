<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Color x:Key="BrandPrimaryColor">#0284C7</Color>
    <Color x:Key="BrandPrimaryHoverColor">#0369A1</Color>
    <Color x:Key="BrandPrimaryDarkColor">#075985</Color>

    <Color x:Key="BrandAccentColor">#0D9488</Color>
    <Color x:Key="BrandAccentHoverColor">#0F766E</Color>

<Color x:Key="HeaderBackgroundColor">#0A2540</Color>
    <Color x:Key="HeaderBorderColor">#1E3A8A</Color>
    <Color x:Key="NavTabActiveColor">#0284C7</Color>
    <Color x:Key="NavTabHoverColor">#1E293B</Color>

<Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardAltBackgroundColor">#F1F5F9</Color>

    <Color x:Key="BorderLightColor">#E2E8F0</Color>
    <Color x:Key="BorderMediumColor">#CBD5E1</Color>
    <Color x:Key="BorderDarkColor">#94A3B8</Color>

<Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#334155</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextLightColor">#FFFFFF</Color>

<Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>

<SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}" />

    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource BrandAccentHoverColor}" />

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="{StaticResource HeaderBorderColor}" />
    <SolidColorBrush x:Key="NavTabActiveBrush" Color="{StaticResource NavTabActiveColor}" />
    <SolidColorBrush x:Key="NavTabHoverBrush" Color="{StaticResource NavTabHoverColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="{StaticResource CardAltBackgroundColor}" />

    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />

<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />

</ResourceDictionary>
