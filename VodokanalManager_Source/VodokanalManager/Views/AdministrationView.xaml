<UserControl x:Class="VodokanalManager.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

<Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Обслуживание базы данных и резервное копирование:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

<Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Текущее расположение файла базы данных (SQLite):" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="Размер базы:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding DatabaseFileSize}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

<Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Открыть папку с БД"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDatabaseFolderCommand}"
                                Margin="0,0,8,4"/>

                        <Button Content="Сменить файл БД..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectDatabaseFileCommand}"
                                Margin="0,0,8,4"/>

                        <Button Content="Создать резервную копию..."
                                Command="{Binding CreateBackupCommand}"
                                Margin="0,0,8,4"/>

                        <Button Content="Восстановить из копии..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RestoreBackupCommand}"
                                Margin="0,0,16,4"/>

<CheckBox Content="Автозаполнение демо-данными при создании новой БД"
                                  IsChecked="{Binding AutoFillDemoData}"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,4"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

<Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Управление учётными записями пользователей системы:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

<Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding UserSearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="Роль:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Grid.Column="3" SelectedIndex="{Binding SelectedRoleFilterIndex}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Все пользователи"/>
                        <ComboBoxItem Content="Только сотрудники"/>
                        <ComboBoxItem Content="Только абоненты (ЛК)"/>
                    </ComboBox>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="Добавить сотрудника"
                                Command="{Binding AddStaffUserCommand}"
                                Margin="0,0,8,0"/>

                        <Button Content="Редактировать"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding EditUserCommand}"
                                Margin="0,0,8,0"/>

                        <Button Content="Изменить активность"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleUserActiveCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Удалить"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteUserCommand}"
                                Margin="0,0,8,0"/>

                        <Button Content="Обновить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadUsersCommand}"/>
                    </StackPanel>
                </Grid>

<DataGrid Grid.Row="2"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="Логин (л/с)" Binding="{Binding Login}" Width="150"/>
                        <DataGridTextColumn Header="ФИО / Наименование" Binding="{Binding FullName}" Width="250"/>
                        <DataGridTextColumn Header="Роль в системе" Binding="{Binding RoleName}" Width="130"/>
                        <DataGridTextColumn Header="Пароль для входа" Binding="{Binding InitialPassword, TargetNullValue='(не задан)'}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
                        <DataGridTextColumn Header="Привязка к л/с" Binding="{Binding SubscriberId, TargetNullValue='—'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <TextBlock Text="💡 Учётные записи абонентов формируются автоматически при регистрации абонента (логин = номер л/с). Пароль отображается в столбце «Пароль для входа». По кнопке «Редактировать» администратор может изменить логин, пароль и статус любой учётной записи."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>

<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,2" Opacity="0.25">
                        <Button Content="[+тест]"
                                ToolTip="Служебная загрузка демонстрационных записей"
                                Command="{Binding LoadDemoDataCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="9"
                                Padding="3,1"
                                Margin="0,0,4,0"
                                Cursor="Hand"/>
                        <Button Content="[-тест]"
                                ToolTip="Очистка демонстрационных записей (IsDemo=1)"
                                Command="{Binding ClearDemoDataCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="9"
                                Padding="3,1"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
