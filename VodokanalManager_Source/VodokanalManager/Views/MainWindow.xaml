<Window x:Class="VodokanalManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VodokanalManager.ViewModels"
        xmlns:views="clr-namespace:VodokanalManager.Views"
        xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common"
        Title="ООО «Водоканал-Сервис» — Абонентский учёт и платежи"
        Height="800" Width="1320"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:StringToVisibilityConverter x:Key="StringToVis" />

        <DataTemplate DataType="{x:Type vm:SubscribersViewModel}">
            <views:SubscribersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MetersReadingsViewModel}">
            <views:MetersReadingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
            <views:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TariffsViewModel}">
            <views:TariffsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdministrationViewModel}">
            <views:AdministrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriberPortalViewModel}">
            <views:SubscriberPortalView />
        </DataTemplate>

<Style x:Key="TaskbarTabStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSubscribersActive}" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" /> 
            <RowDefinition Height="*" />  
            <RowDefinition Height="50" /> 
        </Grid.RowDefinitions>

<Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWaterDrop}"
                          Fill="{StaticResource BrandPrimaryBrush}"
                          Width="26" Height="26"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ООО «Водоканал-Сервис»"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextLightBrush}"/>
                        <TextBlock Text="Красноярский край, г. Канск • Абонентский отдел"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

<Border Grid.Column="1" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Текущий раздел: " FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding ActiveTabName}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="12,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}"/>
                                <TextBlock Text="{Binding CurrentUser.RoleName}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Height="32" Padding="12,0"
                            ToolTip="Сменить пользователя / Выйти из системы">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLogout}" Fill="{StaticResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Выход" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

<ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="12,10,12,6" />

<Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

<ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

<Button Command="{Binding NavigateSubscribersCommand}"
                                Visibility="{Binding CanViewSubscribers, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubscribersActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSubscribers}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Абоненты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigateMetersReadingsCommand}"
                                Visibility="{Binding CanViewMetersReadings, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMetersReadingsActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMeters}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Приборы и показания" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigatePaymentsCommand}"
                                Visibility="{Binding CanViewPayments, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentsActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPayments}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Касса и платежи" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigateTariffsCommand}"
                                Visibility="{Binding CanViewTariffs, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTariffsActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTariffs}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Тарифы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigateReportsCommand}"
                                Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Аналитика и отчёты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigateAdministrationCommand}"
                                Visibility="{Binding CanViewAdministration, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdministrationActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Система и БД" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

<Button Command="{Binding NavigateSubscriberPortalCommand}"
                                Visibility="{Binding CanViewSubscriberPortal, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubscriberPortalActive}" Value="True">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUserPortal}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Личный кабинет" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,4,0">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="БД активна" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="ООО «Водоканал-Сервис» • 2026" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
