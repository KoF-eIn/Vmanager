<UserControl x:Class="VodokanalManager.Views.MetersReadingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
        </Grid.RowDefinitions>

<Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Абонент:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Subscribers}"
                              SelectedItem="{Binding SelectedFilterSubscriber}"
                              DisplayMemberPath="Name"
                              Width="250"/>
                </StackPanel>

                <Button Content="Внести показание"
                        Command="{Binding AddReadingCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="Новый счётчик"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AddMeterCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="Вывести из экспл."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeactivateMeterCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="Обновить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>

<StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

<Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

<Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Приборы учёта (счётчики):" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Удалить прибор"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteMeterCommand}"
                                Height="26" Padding="8,0" FontSize="11"
                                ToolTip="Удалить выбранный прибор учёта"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Meters}"
                              SelectedItem="{Binding SelectedMeter}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ прибора" Binding="{Binding SerialNo}" Width="120"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTypeName}" Width="90"/>
                            <DataGridTextColumn Header="Абонент" Binding="{Binding SubscriberName}" Width="130"/>
                            <DataGridTextColumn Header="Показание, м³" Binding="{Binding LastReadingM3, StringFormat=N3}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

<Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Журнал показаний и начислений:" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Удалить запись"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteReadingCommand}"
                                Height="26" Padding="8,0" FontSize="11"
                                ToolTip="Удалить выбранное показание"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Readings}"
                              SelectedItem="{Binding SelectedReading}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Период" Binding="{Binding Period, StringFormat=MM.yyyy}" Width="80"/>
                            <DataGridTextColumn Header="№ прибора" Binding="{Binding MeterSerialNo}" Width="110"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTypeName}" Width="100"/>
                            <DataGridTextColumn Header="Абонент" Binding="{Binding SubscriberName}" Width="160"/>
                            <DataGridTextColumn Header="Предыдущее, м³" Binding="{Binding PrevValueM3, StringFormat=N3}" Width="110"/>
                            <DataGridTextColumn Header="Текущее, м³" Binding="{Binding ValueM3, StringFormat=N3}" Width="100"/>
                            <DataGridTextColumn Header="Расход, м³" Binding="{Binding ConsumptionM3, StringFormat=N3}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Тариф, ₽/м³" Binding="{Binding PriceRubPerM3, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Начислено, ₽" Binding="{Binding AmountRub, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Внёс" Binding="{Binding UserName}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
