<Window x:Class="VodokanalManager.Views.ReadingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод показания прибора учёта"
        Height="520" Width="480"
        MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Margin="14" Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ввод ежемесячного показания счётчика" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

            <Border Grid.Row="1" x:Name="ErrorBorder" Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    
                    <Border Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="SubscriberInfoText" Text="Абонент: ..." FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="MeterInfoText" Text="Счётчик: ..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="PrevReadingText" Text="Предыдущее показание: 0,000 м³" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

<TextBlock Text="Расчётный период (месяц/год):" Style="{StaticResource LabelTextStyle}"/>
                    <DatePicker x:Name="PeriodDatePicker" SelectedDateChanged="PeriodDatePicker_SelectedDateChanged" Margin="0,0,0,12"/>

<TextBlock Text="Текущее показание счётчика, м³:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="CurrentValueTextBox" TextChanged="CurrentValueTextBox_TextChanged" Margin="0,0,0,12"/>

<Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ConsumptionCalcText" Text="Расход за месяц: 0,000 м³" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                                <TextBlock x:Name="TariffCalcText" Text="Действующий тариф: 0,00 ₽/м³" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="К начислению:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="AmountCalcText" Text="0,00 ₽" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Margin="0,0,8,0" Width="110"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Width="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
