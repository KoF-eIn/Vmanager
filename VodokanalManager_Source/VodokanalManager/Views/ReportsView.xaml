<UserControl x:Class="VodokanalManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
        <common:DebtToColorConverter x:Key="DebtToColor"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

<WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <RadioButton Content="1. Реестр должников"
                                 IsChecked="{Binding IsDebtorsReportVisible, Mode=OneWay}"
                                 Command="{Binding LoadReportCommand}"
                                 GroupName="ReportType"
                                 Style="{StaticResource ReportTabButtonStyle}"
                                 Height="32" Padding="12,0" Margin="0,0,8,4"
                                 Click="ReportType1_Click"/>

                    <RadioButton Content="2. Подозрительный расход"
                                 IsChecked="{Binding IsSuspiciousReportVisible, Mode=OneWay}"
                                 Command="{Binding LoadReportCommand}"
                                 GroupName="ReportType"
                                 Style="{StaticResource ReportTabButtonStyle}"
                                 Height="32" Padding="12,0" Margin="0,0,8,4"
                                 Click="ReportType2_Click"/>

                    <RadioButton Content="3. Потребление воды (диаграмма)"
                                 IsChecked="{Binding IsConsumptionReportVisible, Mode=OneWay}"
                                 Command="{Binding LoadReportCommand}"
                                 GroupName="ReportType"
                                 Style="{StaticResource ReportTabButtonStyle}"
                                 Height="32" Padding="12,0" Margin="0,0,8,4"
                                 Click="ReportType3_Click"/>

                    <RadioButton Content="4. Поступления платежей"
                                 IsChecked="{Binding IsPaymentSummaryVisible, Mode=OneWay}"
                                 Command="{Binding LoadReportCommand}"
                                 GroupName="ReportType"
                                 Style="{StaticResource ReportTabButtonStyle}"
                                 Height="32" Padding="12,0" Margin="0,0,8,4"
                                 Click="ReportType4_Click"/>
                </WrapPanel>

<WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Период с:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="0,0,8,0"/>
                        <TextBlock Text="по:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="0,0,12,0"/>
                    </StackPanel>

                    <Button Content="Сформировать"
                            Command="{Binding LoadReportCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Экспорт в CSV"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportCsvCommand}"
                            Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExport}" Fill="{StaticResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Экспорт в CSV" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

<StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

<Grid Grid.Row="2">

<Border Style="{StaticResource CardBorderStyle}" Margin="0" Visibility="{Binding IsDebtorsReportVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Реестр должников (ранжирование по сумме задолженности):" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DebtorItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="Лицевой счёт" Binding="{Binding AccountNo}" Width="110"/>
                            <DataGridTextColumn Header="Абонент" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding SubscriberTypeName}" Width="130"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="240"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Долг, ₽" Binding="{Binding DebtRub, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Начислено, ₽" Binding="{Binding TotalChargedRub, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="Оплачено, ₽" Binding="{Binding TotalPaidRub, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="Посл. платёж" Binding="{Binding LastPaymentDateText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

<Border Style="{StaticResource CardBorderStyle}" Margin="0" Visibility="{Binding IsSuspiciousReportVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Выявление аномального всплеска расхода (превышение среднего за 3 мес. в 1.5+ раза):" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SuspiciousItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Лицевой счёт" Binding="{Binding AccountNo}" Width="110"/>
                            <DataGridTextColumn Header="Абонент" Binding="{Binding SubscriberName}" Width="240"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTypeName}" Width="100"/>
                            <DataGridTextColumn Header="№ прибора" Binding="{Binding MeterSerialNo}" Width="120"/>
                            <DataGridTextColumn Header="Период" Binding="{Binding PeriodText}" Width="80"/>
                            <DataGridTextColumn Header="Текущий расход, м³" Binding="{Binding ConsumptionM3, StringFormat=N3}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Средний за 3 мес., м³" Binding="{Binding AvgPrev3MonthsM3, StringFormat=N3}" Width="160"/>
                            <DataGridTextColumn Header="Коэффициент" Binding="{Binding Ratio, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Аналитическое заключение" Binding="{Binding Note}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

<Border Style="{StaticResource CardBorderStyle}" Margin="0" Visibility="{Binding IsConsumptionReportVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Помесячная динамика потребления воды абонентами:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

<DataGrid Grid.Column="0" ItemsSource="{Binding MonthlyItems}" Margin="0,0,12,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Период" Binding="{Binding PeriodName}" Width="140"/>
                                <DataGridTextColumn Header="ХВС, м³" Binding="{Binding ColdWaterM3, StringFormat=N3}" Width="90"/>
                                <DataGridTextColumn Header="ГВС, м³" Binding="{Binding HotWaterM3, StringFormat=N3}" Width="90"/>
                                <DataGridTextColumn Header="Всего, м³" Binding="{Binding TotalM3, StringFormat=N3}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

<Border Grid.Column="1" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <Rectangle Width="14" Height="14" Fill="#0284C7" Margin="0,0,6,0"/>
                                    <TextBlock Text="ХВС (м³)" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <Rectangle Width="14" Height="14" Fill="#D97706" Margin="0,0,6,0"/>
                                    <TextBlock Text="ГВС (м³)" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding MonthlyItems}" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" Width="90" Margin="12,0,12,0" VerticalAlignment="Bottom">
                                                    
                                                    <TextBlock Text="{Binding TotalM3, StringFormat=N0}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

<Border Background="#D97706"
                                                            Height="{Binding HotWaterM3}"
                                                            MaxHeight="140"
                                                            CornerRadius="2,2,0,0"
                                                            ToolTip="{Binding HotWaterM3, StringFormat='ГВС: {0:N3} м³'}"/>

<Border Background="#0284C7"
                                                            Height="{Binding ColdWaterM3}"
                                                            MaxHeight="200"
                                                            CornerRadius="0,0,2,2"
                                                            ToolTip="{Binding ColdWaterM3, StringFormat='ХВС: {0:N3} м³'}"/>

<TextBlock Text="{Binding PeriodKey}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

<Border Style="{StaticResource CardBorderStyle}" Margin="0" Visibility="{Binding IsPaymentSummaryVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Сводка поступлений денежных средств по каналам оплаты:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding PaymentSummaryItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethodName}" Width="260"/>
                            <DataGridTextColumn Header="Количество платежей" Binding="{Binding PaymentsCount}" Width="200"/>
                            <DataGridTextColumn Header="Итоговая сумма, ₽" Binding="{Binding TotalAmountRub, StringFormat=N2}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
