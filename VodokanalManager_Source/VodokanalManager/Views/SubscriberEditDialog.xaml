<Window x:Class="VodokanalManager.Views.SubscriberEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Абонент водоканала"
        Height="620" Width="520"
        MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Margin="14" Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="DialogTitleText" Text="Редактирование данных абонента" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

            <Border Grid.Row="1" x:Name="ErrorBorder" Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Номер лицевого счёта (логин в ЛК):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="AccountNoTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="ФИО абонента или наименование организации:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Категория абонента:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox x:Name="SubscriberTypeComboBox" Margin="0,0,0,10">
                        <ComboBoxItem Content="Физическое лицо" Tag="1"/>
                        <ComboBoxItem Content="Организация" Tag="2"/>
                    </ComboBox>

                    <TextBlock Text="Адрес объекта (улица, дом, квартира):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="AddressTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Контактный телефон:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="PhoneTextBox" Margin="0,0,0,10"/>

                    <TextBlock x:Name="PasswordLabelText" Text="Пароль для входа в личный кабинет абонента:" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PasswordTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="🎲 Сгенерировать" Style="{StaticResource SecondaryButtonStyle}" Click="GeneratePassword_Click" Padding="10,0"/>
                    </Grid>

                    <CheckBox x:Name="IsActiveCheckBox" Content="Абонент подключён (активен)" IsChecked="True" Margin="0,4,0,10"/>

                    <Border Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="💡 Учётная запись абонента создаётся автоматически в таблице пользователей (Users). Логин совпадает с номером лицевого счёта. Пароль сохраняется и доступен для просмотра и редактирования в разделе «Система и база данных -> Пользователи»."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Margin="0,0,8,0" Width="110"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Width="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
