<UserControl x:Class="VodokanalManager.Views.SubscriberPortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:VodokanalManager.ViewModels.Common">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
        <common:DebtToColorConverter x:Key="DebtToColor"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">

<Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

<Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0">
                        <TextBlock Text="Личный кабинет абонента водоканала" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Subscriber.Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource HeaderBackgroundBrush}"/>
                        <TextBlock Text="{Binding Subscriber.Address, StringFormat='Адрес объекта: {0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Subscriber.AccountNo, StringFormat='Лицевой счёт: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Текущий долг" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Subscriber.DebtRub, StringFormat={}{0:N2} ₽}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

<Border Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" MinWidth="140">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Всего начислено" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Subscriber.TotalChargedRub, StringFormat={}{0:N2} ₽}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

<Border Background="#F0FDF4" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" MinWidth="140">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Всего оплачено" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Subscriber.TotalPaidRub, StringFormat={}{0:N2} ₽}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

<Button Content="Квитанция на оплату"
                                Command="{Binding PrintCurrentReceiptCommand}"
                                Height="44" Padding="16,0"
                                Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

<Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Передача текущих показаний приборов учёта:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                            <TextBlock Text="Прибор учёта:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding MyMeters}"
                                      SelectedItem="{Binding SelectedMeterForReading}"
                                      DisplayMemberPath="DisplayText"
                                      Width="280"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                            <TextBlock Text="Новое показание, м³:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding InputReadingM3, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="110"/>
                        </StackPanel>

                        <Button Content="Передать показание"
                                Command="{Binding SubmitReadingCommand}"
                                Margin="0,0,0,8"/>
                    </WrapPanel>
                </Grid>
            </Border>

<Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

<Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="История переданных показаний и начислений:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding MyReadings}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Период" Binding="{Binding Period, StringFormat=MM.yyyy}" Width="80"/>
                                <DataGridTextColumn Header="Счётчик" Binding="{Binding MeterSerialNo}" Width="100"/>
                                <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTypeName}" Width="90"/>
                                <DataGridTextColumn Header="Показание, м³" Binding="{Binding ValueM3, StringFormat=N3}" Width="110"/>
                                <DataGridTextColumn Header="Расход, м³" Binding="{Binding ConsumptionM3, StringFormat=N3}" Width="90"/>
                                <DataGridTextColumn Header="Начислено, ₽" Binding="{Binding AmountRub, StringFormat=N2}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

<Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="История платежей абонента:" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding MyPayments}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата платежа" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethodName}" Width="160"/>
                                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding AmountRub, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
