<Window x:Class="VodokanalManager.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётная запись"
        Height="540" Width="500"
        MinHeight="460" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Margin="14" Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="DialogTitleText" Text="Учётная запись пользователя" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

            <Border Grid.Row="1" x:Name="ErrorBorder" Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Имя пользователя (логин / номер л/с):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="LoginTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="ФИО сотрудника или абонента:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="FullNameTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Роль в системе:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox x:Name="RoleComboBox" Margin="0,0,0,12">
                        <ComboBoxItem Content="Администратор" Tag="1"/>
                        <ComboBoxItem Content="Оператор" Tag="2"/>
                        <ComboBoxItem Content="Кассир" Tag="3"/>
                        <ComboBoxItem Content="Абонент (ЛК)" Tag="4"/>
                    </ComboBox>

                    <TextBlock x:Name="PasswordLabelText" Text="Пароль для входа в систему:" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PasswordTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="🎲 Сгенерировать" Style="{StaticResource SecondaryButtonStyle}" Click="GeneratePassword_Click" Padding="10,0"/>
                    </Grid>

                    <CheckBox x:Name="IsActiveCheckBox" Content="Учётная запись активна" IsChecked="True" Margin="0,4,0,12"/>

                    <Border Background="{StaticResource CardAltBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="💡 Вы можете изменить логин и пароль в любой момент. Для абонентов пароль сохраняется в явном виде для удобства выдачи абоненту и одновременно хэшируется по алгоритму PBKDF2."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Margin="0,0,8,0" Width="110"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Width="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
